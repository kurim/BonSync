# Bootstrap-Passwort für den App-Login (nur beim allerersten Start gelesen,
# danach in den Einstellungen änderbar — die Hash wird in der DB gespeichert).
APP_PASSWORD=change-me

# Secret zur Verschlüsselung der Store-Credentials in der DB (min. 16 Zeichen,
# z.B. `openssl rand -base64 32`). NIEMALS nach dem ersten Start ändern, sonst
# sind bestehende Credentials nicht mehr entschlüsselbar -> Module neu verbinden.
APP_SECRET=change-me-too-please-32-chars-min

# Pfad zur SQLite-Datenbankdatei (im Container auf ein Volume gemountet).
DATABASE_PATH=./data/bonsync.db

# Verzeichnis für abgelegte PDFs etc. (im Container auf ein Volume gemountet).
DATA_DIR=./data

# Optional: überschreibt das mTLS-Client-Zertifikat, das das REWE-Modul verwendet. Normalerweise
# NICHT nötig -- das Zertifikat ist eine feste App-Ressource (identisch für jede Installation der
# offiziellen REWE-App, kein nutzerspezifisches Geheimnis, siehe docs/api-rewe.md Abschnitt 1.1)
# und reist bereits im REWE-Modul-Paket mit. Nur setzen, falls REWE das Zertifikat rotiert hat,
# bevor das Modul aktualisiert wurde -- muss dann auf ein Verzeichnis mit client.pem + client.key
# zeigen (extrahiert aus mtls_prod.pfx, siehe docs/api-rewe.md).
# REWE_CERT_DIR=./auth_rewe

PORT=3000
# NODE_ENV wird im Dockerfile bereits auf "production" gesetzt — hier nicht
# nötig (Vite meckert sogar, wenn NODE_ENV=production in der .env steht).

# PFLICHT für Docker/Produktion: die exakte URL, unter der du BonSync im
# Browser aufrufst (Schema + Host + Port, ohne Pfad, ohne Slash am Ende).
# Ohne diese Variable kennt der Server seine eigene Adresse nicht und lehnt
# JEDES Formular (Login, Sync, Speichern, ...) mit "Cross-site POST form
# submissions are forbidden" ab. Beispiele:
#   http://localhost:3000
#   http://192.168.1.50:3000        (Heimnetz-IP des Docker-Hosts)
#   https://bonsync.meine-domain.de (hinter Reverse-Proxy mit TLS)
ORIGIN=http://localhost:3000

# Auf "true" setzen, sobald BonSync nur noch über HTTPS erreichbar ist (z.B.
# hinter einem Reverse-Proxy mit TLS) — macht das Session-Cookie "Secure".
# Im Heimnetz per http:// (Standardfall) auf "false" lassen, sonst kann der
# Browser das Cookie nicht zurücksenden und der Login wirkt "kaputt".
COOKIE_SECURE=false

# Optional: kostenloser API-Key von maptiler.com für die Filial-Standort-Karte auf der
# Märkte-Seite (Kartenkacheln + Geocoding der Beleg-Adressen). Ohne Key wird dort nur ein
# Hinweis statt der Karte angezeigt — der Rest der App funktioniert unverändert.
MAPTILER_API_KEY=
