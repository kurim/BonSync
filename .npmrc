# Das Projekt hat bestehende Peer-Dependency-Überschneidungen zwischen @sveltejs/kit, vite und
# esbuild (mehrere gültige esbuild-Versionen werden von verschiedenen Paketen verlangt) -- ein
# frisches `npm install` ohne vorhandenes node_modules (z.B. im Docker-Build) bricht damit sonst
# hart mit ERESOLVE ab, obwohl die Kombination tatsächlich funktioniert. `legacy-peer-deps`
# schaltet npm auf das alte, tolerantere Auflösungsverhalten (wie npm 6) um.
legacy-peer-deps=true
